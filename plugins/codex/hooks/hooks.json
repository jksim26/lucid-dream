{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/lucid-dream-hook\" codex session-start",
            "commandWindows": "lucid-dream hook session-start --agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/lucid-dream-hook\" codex stop",
            "commandWindows": "lucid-dream hook stop --agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/lucid-dream-hook\" codex session-end",
            "commandWindows": "lucid-dream hook session-end --agent codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
